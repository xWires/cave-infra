#!ipxe

dhcp

menu Choose an OS
item --default exit Exit
item fedora_server Install Fedora Server (auto)
item windows_server Install Windows Server (manual)
choose --timeout 10000 target && goto ${target}

:fedora_server
echo Booting Fedora Server Installer...
kernel http://{{ pxe_server_ip }}/fedora_server/iso/images/pxeboot/vmlinuz inst.repo=http://{{ pxe_server_ip }}/fedora_server/iso {{ '' if not kickstart_src else 'inst.ks=http://' ~ pxe_server_ip ~ '/fedora_server/ks.cfg' }}
initrd http://{{ pxe_server_ip }}/fedora_server/iso/images/pxeboot/initrd.img
boot

:windows_server
echo Booting Windows Server Installer...
kernel http://{{ pxe_server_ip }}/windows_server/wimboot
initrd http://{{ pxe_server_ip }}/windows_server/winpeshl.ini winpeshl.ini
initrd http://{{ pxe_server_ip }}/windows_server/startnet.cmd startnet.cmd
initrd http://{{ pxe_server_ip }}/windows_server/iso/sources/boot.wim boot.wim
boot

:exit
exit
